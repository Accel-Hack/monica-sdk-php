{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.monica.accelhack.net/v1/error.json",
  "title": "MONICA ingest error response",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationIssue"
          }
        }
      },
      "required": [
        "code",
        "message"
      ]
    }
  },
  "required": [
    "error"
  ],
  "$defs": {
    "validationIssue": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "message"
      ]
    }
  }
}
